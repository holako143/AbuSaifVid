{
  "installCommand": "pnpm install",
  "builds": [
    {
      "src": "packages/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "packages/server/package.json",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/trpc/(.*)",
      "destination": "/packages/server/dist/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/packages/client/dist/index.html"
    }
  ]
}
