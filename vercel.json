{
  "version": 2,
  "installCommand": "pnpm install --shamefully-hoist",
  "builds": [
    {
      "src": "packages/client/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "packages/server/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/trpc/:path*",
      "destination": "/packages/server/src/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
