{
  "version": 2,
  "builds": [
    {
      "src": "main_api.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(latest|search|links)",
      "dest": "main_api.py"
    },
    {
      "src": "/(.*)",
      "dest": "/static/$1"
    }
  ]
}
